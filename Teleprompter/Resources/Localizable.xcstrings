    "正在分离并合成前景人声…" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Separating and mixing foreground voices…" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在分離並合成前景人聲…" } },
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ فصل الأصوات البشرية الأمامية ومزجها…" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Vordergrundstimmen werden getrennt und gemischt…" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Separando y mezclando las voces en primer plano…" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Séparation et mixage des voix au premier plan…" } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सामने की आवाज़ें अलग करके मिक्स की जा रही हैं…" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Memisahkan dan mencampur vokal latar depan…" } },
