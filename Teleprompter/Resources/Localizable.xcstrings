    "参考文稿仅用于校正识别结果，不会替代视频中的语音。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The reference script is used only to correct recognition results and will not replace speech in the video." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "參考稿僅用於校正辨識結果，不會取代影片中的語音。" } },
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يُستخدم النص المرجعي فقط لتصحيح نتائج التعرّف، ولن يستبدل الكلام في الفيديو." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Referenztext dient nur zur Korrektur der Erkennungsergebnisse und ersetzt nicht die Sprache im Video." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El guion de referencia solo se usa para corregir los resultados del reconocimiento y no sustituirá el audio hablado del vídeo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le texte de référence sert uniquement à corriger les résultats de reconnaissance et ne remplace pas la voix de la vidéo." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "संदर्भ स्क्रिप्ट का उपयोग केवल पहचान परिणामों को सुधारने के लिए होता है; यह वीडियो की आवाज़ को प्रतिस्थापित नहीं करेगी।" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Naskah referensi hanya digunakan untuk mengoreksi hasil pengenalan dan tidak akan menggantikan ucapan dalam video." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il testo di riferimento viene usato solo per correggere i risultati del riconoscimento e non sostituisce il parlato nel video." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "参照原稿は認識結果の補正にのみ使用され、動画内の音声を置き換えることはありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "참고 원고는 인식 결과 교정에만 사용되며 영상 속 음성을 대체하지 않습니다." } },
        "ms" : { "stringUnit" : { "state" : "translated", "value" : "Skrip rujukan hanya digunakan untuk membetulkan hasil pengecaman dan tidak akan menggantikan pertuturan dalam video." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De referentietekst wordt alleen gebruikt om herkenningsresultaten te corrigeren en vervangt de spraak in de video niet." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Tekst referencyjny służy wyłącznie do korygowania wyników rozpoznawania i nie zastąpi mowy w filmie." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O roteiro de referência é usado apenas para corrigir os resultados do reconhecimento e não substituirá a fala do vídeo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Текст для сверки используется только для коррекции результатов распознавания и не заменяет речь в видео." } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "สคริปต์อ้างอิงใช้เพื่อแก้ไขผลการรู้จำเท่านั้น และจะไม่แทนที่เสียงพูดในวิดีโอ" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Referans metni yalnızca tanıma sonuçlarını düzeltmek için kullanılır ve videodaki konuşmanın yerini almaz." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Текст для звірки використовується лише для коригування результатів розпізнавання й не замінює мовлення у відео." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kịch bản tham chiếu chỉ được dùng để sửa kết quả nhận dạng và không thay thế lời nói trong video." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Referenční text slouží pouze k opravě výsledků rozpoznávání a nenahrazuje řeč ve videu." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Referensmanuset används bara för att korrigera igenkänningsresultatet och ersätter inte talet i videon." } }
      }
    },
